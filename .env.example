# Required
# Create a key at https://openrouter.ai/keys. This account pays for the Director
# LLM, GPT Image 2 image generation and Seedance video generation.
OPENROUTER_API_KEY=

# Server (optional)
# HTTP port. Default: 3111.
PORT=3111
# Bind address. Default: 0.0.0.0.
HOST=0.0.0.0

# Text-to-speech (optional)
ELEVENLABS_API_KEY=

# HyperFrames motion-graphics render node (optional)
RENDER_NODE_URL=
RENDER_NODE_TOKEN=

# Knowledge-base integration (optional)
# The default URL is an example GTS-compatible endpoint.
GTS_API_TOKEN=
GTS_BASE_URL=https://gts.kuble.com/api/chatgpt

# Auth proxy (optional)
# Leave both unset for local use. Set these only when operating behind an auth
# proxy; ADMIN_EMAILS is a comma-separated allowlist with no built-in default.
AUTH_WHOAMI_URL=
ADMIN_EMAILS=

# Public references (optional)
# Needed when Seedance receives audio or video references (the URL must be
# publicly reachable over HTTPS) and as the base of the Higgsfield login callback
# (<PUBLIC_BASE_URL>/api/higgsfield/oauth/callback). Set it when the app runs
# behind a reverse proxy; without it the callback URL is derived from the request.
PUBLIC_BASE_URL=
# Only if a trusted reverse proxy sets X-Forwarded-Host and PUBLIC_BASE_URL is unset: TRUST_PROXY_HOST=1

# Higgsfield uses no API key. Connect it with the button in Settings (OAuth login in the browser).
