# Required
# Create a key at https://openrouter.ai/keys. This account pays for the Director
# LLM, GPT Image 2 image generation and Seedance video generation.
OPENROUTER_API_KEY=

# Server (optional)
# HTTP port. Default: 3111.
PORT=3111
# Bind address. Default: 0.0.0.0.
HOST=0.0.0.0

# Text-to-speech, music and song text of the node view (optional)
ELEVENLABS_API_KEY=

# fal.ai (optional)
# Enables the fal.ai nodes of the node view (MiniMax H3 Max and any other fal model).
# Create a key at https://fal.ai/dashboard/keys.
FAL_KEY=

# HyperFrames motion-graphics render node (optional)
RENDER_NODE_URL=
RENDER_NODE_TOKEN=

# Knowledge-base integration (optional)
# The default URL is an example GTS-compatible endpoint.
GTS_API_TOKEN=
GTS_BASE_URL=https://gts.kuble.com/api/chatgpt

# User management (optional)
# Leave these unset for local use: the app is then open and single-machine.
# AUTH_WHOAMI_URL turns user management on. It is the whoami endpoint of your login
# (it answers {"logged_in": true, "email": "..."} for the caller's cookie); the login
# itself stays outside the app. New chats and workflows then start private and can be
# shared with the team or selected people.
# ADMIN_EMAILS: comma-separated admins (no built-in default).
# SUPERADMIN_EMAILS: comma-separated superadmins of any domain; they are admins too and
# may open /monitoring.html. Environment only, never editable in the app.
# AUTH_LOGOUT_URL: optional sign-out link (https://... or an absolute path) for the account menu.
AUTH_WHOAMI_URL=
ADMIN_EMAILS=
SUPERADMIN_EMAILS=
AUTH_LOGOUT_URL=

# Teams with a USD budget (optional, needs AUTH_WHOAMI_URL)
# INTERNAL_EMAIL_DOMAINS: comma-separated e-mail domains of your own organisation, e.g.
# example.com. Logged-in addresses of these domains are internal people; every other
# logged-in address is a participant (member of a team) or a guest (no team, no budget).
# Unset = everybody logged in counts as internal (the behaviour without teams), EXCEPT addresses
# that are or were in any team (also removed or archived): they count as guests. Set it in every
# installation that uses teams; the app warns at startup and in the teams settings while it is empty.
# BUDGET_ASYNC_HOLD_USD (default 2) is reserved for every video job of a participant until the
# provider has billed it; BUDGET_MAX_OPEN_JOBS (default 2) limits how many such jobs are open at once.
# ELEVENLABS_USD_PER_1K_CHARS (default 0.30) prices speech, ELEVENLABS_MUSIC_USD_PER_MIN (default 0.20) prices music,
# ELEVENLABS_TIMING_USD_PER_HOUR (default 0.40) prices the word times of a song (all are estimates; the ElevenLabs
# Music API needs a paid ElevenLabs plan).
INTERNAL_EMAIL_DOMAINS=
# Allowlist sync: keeps the members of active teams in the allowlist file of your login.
# ACCESS_ALLOWLIST_FILE is the JSON file ({"routes": [{"path": "/training", "extra_emails": []}]}),
# ACCESS_ALLOWLIST_ROUTE the route to maintain. Both or none; manual entries are never removed.
ACCESS_ALLOWLIST_FILE=
ACCESS_ALLOWLIST_ROUTE=

# Public references (optional)
# Needed when Seedance receives audio or video references (the URL must be
# publicly reachable over HTTPS) and as the base of the Higgsfield login callback
# (<PUBLIC_BASE_URL>/api/higgsfield/oauth/callback). Set it when the app runs
# behind a reverse proxy; without it the callback URL is derived from the request.
PUBLIC_BASE_URL=
# Only if a trusted reverse proxy sets X-Forwarded-Host and PUBLIC_BASE_URL is unset: TRUST_PROXY_HOST=1

# Higgsfield uses no API key. Connect it with the button in Settings (OAuth login in the browser).
