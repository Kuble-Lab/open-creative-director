                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/AlligatorKeyframe"
                },
                "maxItems": 10,
                "description": "Keyframe images pinned to frame positions in the generated video. Up to 10 keyframes with unique `frame_index` values."
              },
              "resolution": {
                "enum": [
                  "720p",
                  "1080p"
