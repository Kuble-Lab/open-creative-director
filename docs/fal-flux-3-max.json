      "info": {
        "title": "Queue OpenAPI for blackforestlabs/flux-3-max/keyframes-to-video",
        "version": "1.0.0",
        "description": "FLUX 3 Max keyframes to video from Black Forest Labs. Input: keyframes (list of image_url + frame_index, at most duration x fps) and a prompt describing how the video moves between them. Options: duration 5-20 seconds (default 5), aspect_ratio (auto, 21:9, 2:1, 16:9, 4:3, 1:1, 3:4, 9:16; default auto), generate_audio (default true), reasoning_level low or high (default high, the model expands your prompt), seed. Output: 720p video with native audio. Billed per second of generated video.",
        "x-fal-metadata": {
          "endpointId": "blackforestlabs/flux-3-max/keyframes-to-video",
          "category": "image-to-video",
          "thumbnailUrl": "https://v3b.fal.media/files/b/0aae8cf6/-Cuw8bwhTM9rdnwq7eICJ.jpg",
          "playgroundUrl": "https://fal.ai/models/blackforestlabs/flux-3-max/keyframes-to-video",
          "documentationUrl": "https://fal.ai/models/blackforestlabs/flux-3-max/keyframes-to-video/api",
          "about": "Generate a video through keyframe images pinned to frame positions."
        }
      },
