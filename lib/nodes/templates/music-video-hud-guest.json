{
  "id": "music-video-hud-guest",
  "format": "ocd.workflow",
  "version": 1,
  "name": "Music video in the HUD style (guest duet)",
  "description": "Upload a duet song and its final lyrics. Choose a guest influencer or describe the guest in the Guest field. Whole lines in round brackets or marked [Choir] become short guest lip-sync units; the lead keeps the other sung units. Two character sheets preserve the separate identities in scene pictures, lead first and guest second. Approve the brief, board, both sheets and pictures before the clips and HUD. A guest identity is required in this template: without one the required prompt of the guest sheet is empty; use the your-song template for a solo film.",
  "requires": [
    "openrouter",
    "ffmpeg",
    "elevenlabs",
    "fal",
    "rendernode"
  ],
