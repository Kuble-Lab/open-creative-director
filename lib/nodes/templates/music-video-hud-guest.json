        "type": "music_video.hud_plan",
        "typeVersion": 1,
        "x": 960,
        "y": 200,
        "params": {
          "model": "",
          "brief": "",
          "figure": "NAME: Claudia\nFULL: a 28-year-old Caucasian American woman with a grown-up angular face, defined cheekbones and a strong jawline, pale skin and light freckles, a glossy black blunt jaw-length bob with heavy straight bangs and one clay-orange streak through the bangs, a small flat clay-orange eight-pointed star hair clip, a thin headset microphone at her cheek\nSHORT: a Caucasian American woman in her late twenties with pale skin and a glossy black blunt bob with heavy straight bangs and one clay-orange streak, a thin headset microphone\nLOOKS: editorial pop-star wardrobe that changes per chapter (for example a white cropped puff-sleeve shirt with a black pleated coated-nylon skirt, a liquid-chrome bodysuit, a glossy cobalt-blue patent-leather trench over white satin); the clay-orange streak and the star clip are the only clay accents on her\nFACE: a deadpan, curious resting face; when she sings, her mouth opens wide\nNEVER: a second Claudia, the word young, a microphone in front of her mouth when she sings\nCREDIT: Claudia by anabology (claudia.gallery)",
          "style": "",
          "theme": "hud",
          "accent": "#3B82F6",
          "hud_language": "en",
          "brief_language": "en",
          "official_images": true,
          "listen": true,
          "cuts_from_song": true,
          "cuts_per_minute": 24,
          "max_units": 50,
          "lipsync_seconds_per_minute": 22,
          "motion_share": 1,
          "clip_seconds": 5,
          "broll_share": 0.35,
          "allow_plain": false,
          "guest": ""
        }
